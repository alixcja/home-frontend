server {
    listen 8080;
    server_name localhost;

    root /app/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Optional: Fehlerseiten abfangen
    error_page 500 502 503 504 /50.html;
    location = /50.html {
        root /usr/share/nginx/html;
    }
}